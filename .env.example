# Etherscan API key (works for all EVM chains in V2)
ETHERSCAN_KEY=your_etherscan_api_key

# RPC overrides (optional)
ETH_RPC_URL=https://eth.drpc.org

# Solana
SOLSCAN_KEY=

# Price API (optional, CoinGecko free tier works without key)
COINGECKO_KEY=

# Free rate limits from https://dashboard.helius.dev/
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=API_KEY

